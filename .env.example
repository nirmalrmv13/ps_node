PORT=5000
CORS_ORIGIN=http://localhost:5173

# Local MySQL: localhost / 3306. TiDB Cloud: gateway host / port 4000 (TLS auto-enabled when host is not localhost)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=serene_sanctuary

BUSINESS_NAME=Pro Signature Unisex Salon
BUSINESS_TAGLINE="Your Look, Our Signature"
BUSINESS_GSTIN=29AABCS1234K1Z5
POS_TERMINAL="Chamber Suite III • Terminal 04"
POS_REGISTER=REG-01
POS_CASH_FLOAT=10000
SALON_OPENS_AT=09:00
SALON_CLOSES_AT=21:00
# Online booking page: minimum notice and how far ahead clients can book
ONLINE_BOOKING_LEAD_MINUTES=60
ONLINE_BOOKING_DAYS_AHEAD=30
LOW_STOCK_THRESHOLD=5
LOYALTY_STARS_FOR_FREE=5
GST_RATE=12

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# Used by "npm run db:setup" to create the login users
# Admin: everything, including Inventory, Purchases, Reports and all masters
ADMIN_USERNAME=serene_guest
ADMIN_EMAIL=guest@serenesanctuary.com
ADMIN_NAME=Serene Guest
ADMIN_PASSWORD=change-me
# Staff: Billing, Billing History, Appointments and Customers
STAFF_USERNAME=front_desk
STAFF_EMAIL=frontdesk@serenesanctuary.com
STAFF_NAME=Front Desk
STAFF_PASSWORD=change-me
